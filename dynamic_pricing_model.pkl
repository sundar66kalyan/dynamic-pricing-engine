      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "import joblib\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "data_size = 1000\n",
        "\n",
        "inventory = np.random.randint(10,500,data_size)\n",
        "demand = np.random.randint(10,500,data_size)\n",
        "competitor_price = np.random.randint(5,100,data_size)\n",
        "\n",
        "price = (\n",
        "    50\n",
        "    + demand * 0.3\n",
        "    - inventory * 0.05\n",
        "    + competitor_price * 0.4\n",
        "    + np.random.normal(0,5,data_size)\n",
        ")\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"inventory\":inventory,\n",
        "    \"demand\":demand,\n",
        "    \"competitor_price\":competitor_price,\n",
        "    \"price\":price\n",
        "})\n",
        "\n",
        "X = df[[\"inventory\",\"demand\",\"competitor_price\"]]\n",
        "y = df[\"price\"]\n",
        "\n",
        "model = RandomForestRegressor()\n",
        "model.fit(X,y)\n",
        "\n",
        "joblib.dump(model,\"dynamic_pricing_model.pkl\")\n",
        "\n",
        "print(\"Model trained and saved.\")"
      ]
    }
  ]
}